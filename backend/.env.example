PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5433/reachinbox?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Limits and Delays
WORKER_CONCURRENCY=2
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=3
MAX_HOURLY_LIMIT_CAP=100

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Auth Secrets (Google OAuth)
GOOGLE_CLIENT_ID=placeholder_client_id
GOOGLE_CLIENT_SECRET=placeholder_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
SESSION_SECRET=placeholder_session_secret

# Slack OAuth (placeholders for Step 10)
SLACK_CLIENT_ID=placeholder_slack_client_id
SLACK_CLIENT_SECRET=placeholder_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:4000/auth/slack/callback

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# Ethereal Email (Optional - will auto-create test account if empty)
ETHEREAL_USER=
ETHEREAL_PASS=

